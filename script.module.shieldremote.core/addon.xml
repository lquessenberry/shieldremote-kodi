<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.module.shieldremote.core"
       name="ShieldRemote Core"
       version="0.1.0"
       provider-name="Lee Quessenberry">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.module" library="lib"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Shared Shield remote protocol clients and storage</summary>
    <description lang="en_GB">Pure-Python core for Android TV Remote v2 (stub/mock), optional Kodi JSON-RPC, and cert storage paths. Designed for Kodi 21 Omega on Anbernic ARC-D.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/local/shieldremote-kodi</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
