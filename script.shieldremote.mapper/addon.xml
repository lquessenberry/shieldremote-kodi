<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.shieldremote.mapper"
       name="ShieldRemote Mapper"
       version="0.2.0"
       provider-name="Lee Quessenberry">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.shieldremote.core" version="0.2.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Map Kodi actions / joystick buttons to Shield keycodes</summary>
    <description lang="en_GB">Default profiles mapping common Kodi Action IDs and ARC-D gamepad buttons to Android keycodes. Includes joystick.xml notes for Anbernic RG ARC-D.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
