      <font>font30</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF2E7D32">white.png</texturefocus>
      <texturenofocus colordiffuse="FF37474F">white.png</texturenofocus>
    </control>

    <!-- System / media cluster (right) -->
    <control type="button" id="1006">
      <description>Back</description>
      <posx>500</posx>
      <posy>100</posy>
      <width>160</width>
      <height>90</height>
