      <font>font18</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF546E7A">white.png</texturefocus>
      <texturenofocus colordiffuse="FF37474F">white.png</texturenofocus>
    </control>
    <control type="button" id="1013">
