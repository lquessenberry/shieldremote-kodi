<?xml version="1.0" encoding="UTF-8"?>
<!--
  Large-button touch remote for Anbernic RG ARC-D (640×480 physical).
  Skin resolution 720p is Kodi's common XML coordinate space; controls
  are oversized for finger targets on a 4" 4:3 panel.
-->
<window>
  <defaultcontrol always="true">1005</defaultcontrol>
  <controls>
    <control type="image">
      <description>Background</description>
      <posx>0</posx>
      <posy>0</posy>
      <width>1280</width>
      <height>720</height>
      <texture colordiffuse="FF1A1A1A">white.png</texture>
    </control>

    <control type="label">
      <description>Title</description>
      <posx>40</posx>
      <posy>20</posy>
      <width>600</width>
      <height>50</height>
      <label>Shield Remote</label>
      <font>font14</font>
      <textcolor>FFFFFFFF</textcolor>
    </control>

    <!-- D-pad cluster (left) -->
    <control type="button" id="1001">
      <description>Up</description>
      <posx>160</posx>
      <posy>100</posy>
      <width>140</width>
      <height>100</height>
      <label>▲</label>
      <font>font30</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF2E7D32">white.png</texturefocus>
      <texturenofocus colordiffuse="FF37474F">white.png</texturenofocus>
    </control>
    <control type="button" id="1003">
      <description>Left</description>
      <posx>40</posx>
      <posy>220</posy>
      <width>140</width>
      <height>100</height>
      <label>◀</label>
      <font>font30</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF2E7D32">white.png</texturefocus>
      <texturenofocus colordiffuse="FF37474F">white.png</texturenofocus>
    </control>
    <control type="button" id="1005">
      <description>OK</description>
      <posx>160</posx>
      <posy>220</posy>
      <width>140</width>
      <height>100</height>
      <label>OK</label>
      <font>font30</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF1565C0">white.png</texturefocus>
      <texturenofocus colordiffuse="FF455A64">white.png</texturenofocus>
    </control>
    <control type="button" id="1004">
      <description>Right</description>
      <posx>280</posx>
      <posy>220</posy>
      <width>140</width>
      <height>100</height>
      <label>▶</label>
      <font>font30</font>
      <textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="FF2E7D32">white.png</texturefocus>
      <texturenofocus colordiffuse="FF37474F">white.png</texturenofocus>
    </control>
    <control type="button" id="1002">
      <description>Down</description>
      <posx>160</posx>
      <posy>340</posy>
      <width>140</width>
      <height>100</height>
